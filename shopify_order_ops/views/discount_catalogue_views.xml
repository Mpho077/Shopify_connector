<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="shopify_discount_list" model="ir.ui.view">
        <field name="name">shopify.discount.list</field>
        <field name="model">shopify.discount</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="method"/>
                <field name="applies_to"/>
                <field name="summary"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'scheduled'"
                       decoration-muted="status in ('expired', 'disabled')"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="shopify_discount_form" model="ir.ui.view">
        <field name="name">shopify.discount.form</field>
        <field name="model">shopify.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success"
                            invisible="status != 'active'"/>
                    <widget name="web_ribbon" title="Scheduled" bg_color="text-bg-info"
                            invisible="status != 'scheduled'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-secondary"
                            invisible="status != 'expired'"/>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Discount title"/></h1>
                    </div>
                    <group>
                        <group string="Method">
                            <field name="method"/>
                            <field name="applies_to"/>
                            <field name="codes" invisible="method != 'code'"/>
                            <field name="shopify_discount_id" readonly="1"/>
                            <field name="active"/>
                            <field name="status"/>
                        </group>
                        <group string="Value">
                            <field name="value_type"/>
                            <field name="value_percent" invisible="value_type != 'percentage'"/>
                            <field name="value_amount" invisible="value_type != 'fixed_amount'"/>
                            <field name="purchase_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Eligibility">
                            <field name="customer_eligibility"/>
                        </group>
                        <group string="Minimum requirements">
                            <field name="min_requirement"/>
                            <field name="min_amount" invisible="min_requirement != 'amount'"/>
                            <field name="min_qty" invisible="min_requirement != 'quantity'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Combinations">
                            <field name="combines_product"/>
                            <field name="combines_order"/>
                            <field name="combines_shipping"/>
                        </group>
                        <group string="Active dates">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="usage_count"/>
                            <field name="usage_limit"/>
                        </group>
                    </group>
                    <field name="summary" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="shopify_discount_search" model="ir.ui.view">
        <field name="name">shopify.discount.search</field>
        <field name="model">shopify.discount</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="codes"/>
                <field name="shopify_discount_id"/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_automatic" string="Automatic" domain="[('method', '=', 'automatic')]"/>
                <filter name="filter_code" string="Discount codes" domain="[('method', '=', 'code')]"/>
            </search>
        </field>
    </record>
    <record id="action_shopify_discount" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">shopify.discount</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
