<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="shopify_sync_log_list" model="ir.ui.view">
        <field name="name">shopify.sync.log.list</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="id"/>
                <field name="level"/>
                <field name="source"/>
                <field name="message"/>
                <field name="shopify_order_ref"/>
                <field name="job_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="shopify_sync_log_form" model="ir.ui.view">
        <field name="name">shopify.sync.log.form</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="level"/>
                        <field name="source"/>
                        <field name="shopify_order_ref"/>
                        <field name="job_id"/>
                    </group>
                    <label for="message"/>
                    <field name="message" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_shopify_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
