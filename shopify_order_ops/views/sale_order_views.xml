<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_shopify_ops" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.shopify.ops</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_shopify_sync_lines_from_shopify"
                        type="object"
                        string="Sync lines from Shopify"
                        class="btn-secondary"
                        invisible="not shopify_order_id and not client_order_ref"
                        groups="sales_team.group_sale_manager"
                        confirm="Pull the current Shopify line items onto this order? Shopify is not changed."/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="shopify_ops" string="Shopify">
                    <group>
                        <field name="shopify_order_id"/>
                        <field name="shopify_order_name"/>
                        <field name="shopify_discount_codes"/>
                        <field name="shopify_coupon_code" invisible="shopify_order_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_shopify_ops" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.shopify.ops</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="shopify_order_id" optional="hide" string="Shopify ID"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_shopify_ops" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.shopify.ops</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="shopify_order_id"/>
                <field name="shopify_order_name"/>
                <field name="shopify_discount_codes"/>
            </xpath>
        </field>
    </record>
</odoo>
