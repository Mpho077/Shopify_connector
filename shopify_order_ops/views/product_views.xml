<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_inherit_shopify_ops" model="ir.ui.view">
        <field name="name">product.template.form.inherit.shopify.ops</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_push_to_shopify"
                        string="Push to Shopify"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cloud-upload"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="shopify_compare_at_price"
                       string="Shopify Compare-at (RRP)"/>
            </xpath>
        </field>
    </record>
</odoo>
