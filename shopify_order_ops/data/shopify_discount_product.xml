<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="product_template_shopify_discount" model="product.template">
        <field name="name">Shopify Discount</field>
        <field name="default_code">SHOPIFY-DISCOUNT</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="invoice_policy">order</field>
    </record>
    <record id="product_template_shopify_shipping" model="product.template">
        <field name="name">Shopify Shipping</field>
        <field name="default_code">SHOPIFY-SHIPPING</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="invoice_policy">order</field>
    </record>
</odoo>
