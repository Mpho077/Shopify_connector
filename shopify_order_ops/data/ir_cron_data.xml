<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_jobs" model="ir.cron">
        <field name="name">Shopify Ops: process queued jobs</field>
        <field name="model_id" ref="model_shopify_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_inventory_push" model="ir.cron">
        <field name="name">Shopify Ops: push inventory levels</field>
        <field name="model_id" ref="model_shopify_inventory_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_push_inventory()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_inventory_dirty_push" model="ir.cron">
        <field name="name">Shopify Ops: push changed inventory (real-time mode)</field>
        <field name="model_id" ref="model_shopify_inventory_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_push_inventory_dirty()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_fulfillment_push" model="ir.cron">
        <field name="name">Shopify Ops: sync fulfillments</field>
        <field name="model_id" ref="model_shopify_fulfillment_sync"/>
