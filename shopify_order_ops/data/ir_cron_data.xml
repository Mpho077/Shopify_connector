        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_customer_sync" model="ir.cron">
        <field name="name">Shopify Ops: sync customers</field>
        <field name="model_id" ref="model_shopify_customer_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_customers()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_product_sync" model="ir.cron">
        <field name="name">Shopify Ops: sync products</field>
        <field name="model_id" ref="model_shopify_product_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_products()</field>
        <field name="interval_number">120</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_price_sync" model="ir.cron">
        <field name="name">Shopify Ops: sync prices</field>
        <field name="model_id" ref="model_shopify_price_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_prices()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_discount_catalogue" model="ir.cron">
        <field name="name">Shopify Ops: sync discount catalogue</field>
        <field name="model_id" ref="model_shopify_discount_catalogue_sync"/>
